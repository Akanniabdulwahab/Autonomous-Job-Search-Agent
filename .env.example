# Search providers - never commit real keys
TAVILY_API_KEY=
EXA_API_KEY=
# Example: https://your-searxng-host.example
SEARXNG_URL=

# Google
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
GOOGLE_SHEET_ID=
GOOGLE_DOC_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Agent policy
LOOKBACK_DAYS=15
SCAN_INTERVAL_HOURS=4
MAX_RESULTS_PER_QUERY=8
MAX_PAGE_FETCHES_PER_RUN=18
MAX_TELEGRAM_ALERTS=10

# Hard free-provider budgets. The agent never upgrades or falls back to paid billing.
MAX_TAVILY_SEARCHES_PER_DAY=20
MAX_EXA_SEARCHES_PER_DAY=10
SEARXNG_MAX_QUERIES_PER_RUN=6

# Firecrawl is disabled by default. Keep 0 for the strict $0 design.
USE_FIRECRAWL=0
FIRECRAWL_API_KEY=

# Optional source registry override. Leave blank for built-in rotation.
JOB_SOURCE_DOMAINS=
